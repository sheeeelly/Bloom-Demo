# Bloom 本地配置
# 复制为 .env 后填写。不要把填好的 .env 提交进仓库。

ENV=local
PORT=8000

# 历史出图目录。留空则使用 data/history（已被 git 忽略）
HISTORY_DIR=

# true 才会调用外部推理出真图；false 时两间工作室仍可操作界面
SYNTHESIS_GPU_ENABLED=false

# 推理实例。只在本机填写，留空则不出真图
XGY_OPEN_API_TOKEN=
XGY_OPEN_API_BASE_URL=
XGY_INSTANCE_ID=

XGY_REQUEST_TIMEOUT_SECONDS=30
XGY_REQUEST_RETRIES=3
XGY_BOOT_WAIT_TIMEOUT_SECONDS=180
XGY_BOOT_POLL_INTERVAL_SECONDS=5
XGY_IDLE_SHUTDOWN_SECONDS=0
XGY_IDLE_CHECK_INTERVAL_SECONDS=60

COMFY_SCHEME=https
COMFY_PORT=8188
COMFY_HOST_SUFFIX=
COMFY_READY_TIMEOUT_SECONDS=90
COMFY_READY_POLL_INTERVAL_SECONDS=3
COMFY_GENERATE_TIMEOUT_SECONDS=1800
COMFY_GENERATE_POLL_INTERVAL_SECONDS=3

# 留空则使用仓库内工作流
COMFY_WORKFLOW_TEMPLATE_PATH=
COMFY_FASHION_WORKFLOW_TEMPLATE_PATH=
COMFY_GAP_FUSION_WORKFLOW_TEMPLATE_PATH=

# 出图密钥与私有网关。只写在本机 .env，程序提交时注入，不要写进 workflows/*.json
CLOUDSWAY_API_KEY=
CLOUDSWAY_GPT_BASE_URL=
CLOUDSWAY_GPT_MODEL_ID=
CLOUDSWAY_IMAGE_BASE_URL=
CLOUDSWAY_IMAGE_MODEL_ID=
